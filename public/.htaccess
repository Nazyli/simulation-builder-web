<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Keep real files and directories (JS, CSS, images, etc.) unchanged.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Let React Router handle client-side routes such as /studio and /simulation.
  RewriteRule ^ index.html [L]
</IfModule>
